    "#@title 3. Run OSINT Retention Director (Input Your Concept)\n",
    "USER_PROMPT = \"a drunk man dancing realistic in the street\" #@param {type:\"string\"}\n",
    "\n",
    "# OSINT Engine Logic\n",
    "def build_retention_prompt(raw_prompt):\n",
    "    return (\n",
    "        f\"Hyper-realistic raw mobile video capture of {raw_prompt}, \"\n",
    "        f\"photorealistic street documentary style, cinematic unpolished motion, \"\n",
    "        f\"raw ambient street sodium lighting, handheld camera shake, authentic physics, \"\n",
    "        f\"8k resolution, subsurface skin scattering, masterpiece fidelity, 60fps\"\n",
    "    )\n",
    "\n",
    "negative_prompt = \"cartoon, 3D render, smooth plastic, anime, flashy artificial lighting, deformed limbs, extra legs, distorted anatomy, oversaturated, watermark\"\n",
    "\n",
    "enhanced_prompt = build_retention_prompt(USER_PROMPT)\n",
    "print(f\"\\n[DIRECTOR ENHANCED PROMPT]:\\n{enhanced_prompt}\\n\")\n",
    "print(f\"[AUDIO DIRECTED SCORE]: 104 BPM Syncopated Lo-Fi Breakbeat + Foley scuffs & street ambience\")"
   ]
